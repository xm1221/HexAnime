{
  text: {
    "autoconfig.hexanime": {
      title: "HexAnime",

      category: {
        client: "客户端",
        server: "服务端",
      },

      option: {
        client: {
          enabled: {
            "": "启用动画",
            "@Tooltip": "总开关：控制 HexAnime 的手臂与物品动画。",
          },
          damageAnimations: {
            "": "损坏动画",
            "@Tooltip": "媒质或耐久较低时显示颤抖与下垂反馈。",
          },
          cameraShake: {
            "": "视野晃动",
            "@Tooltip": "法杖结术、物品耗尽和施法事故时给镜头一个短促冲击。",
          },
          mishapScreenEffects: {
            "": "事故屏幕特效",
            "@Tooltip": "为媒质、空间和心智事故添加稀有且区分类别的屏幕花纹。",
          },
          firstPersonAnimations: {
            "": "第一人称动画",
            "@Tooltip": "让封装咒术使用原版第一人称模型动画；法杖瞄准仍使用专用手部路径。",
          },
          syncToServer: {
            "": "发送动画状态",
            "@Tooltip": "把你的法杖瞄准状态发送给服务器，供其他玩家看到。",
          },
          receiveRemoteAim: {
            "": "接收法杖瞄准",
            "@Tooltip": "允许服务器向你发送其他玩家的连续法杖瞄准。",
          },
          receiveRemoteEvents: {
            "": "接收施法事件",
            "@Tooltip": "允许接收释放、损坏、耗尽和事故动画事件。",
          },
          staffTipParticles: {
            "": "杖尖微粒",
            "@Tooltip": "透支应变较高时，在杖尖显示少量与颜料同色的微粒。",
          },
          cameraRollAndFov: {
            "": "镜头侧倾与视野脉冲",
            "@Tooltip": "施法蓄力微收视野、结术释放瞬间脉冲外扩，并在横扫与事故时产生短暂侧倾。",
          },
          comboResonance: {
            "": "蓄力共鸣与连携增幅",
            "@Tooltip": "随连续绘制图案数量与连发次数提升施法架势张力与轻微悬浮感。",
          },
          offhandEnergyPose: {
            "": "副手聚能与媒介共鸣",
            "@Tooltip": "施法时让空副手呈掌心托气手势，或将法术核心/法术书抬至胸前共鸣。",
          },
          materialVfxAndAudio: {
            "": "材质特效与轻音效",
            "@Tooltip": "为木质、淬火紫晶、思维编织与事故崩解添加专属粒子火花与轻度音效。",
          },
          arcaneCircleAndTrail: {
            "": "简约 3D 法阵与杖尖光带",
            "@Tooltip": "施法时在脚下绘制与颜料同色的几何光环，并在挥杖轨迹后留下轻量光带。",
          },
          circleHexPatterns: {
            "": "法阵投影 Hex 图案",
            "@Tooltip": "在 3D 法阵内实时绘制已画与正在绘制的 Hex 图案。",
          },
          expandingMagicCircle: {
            "": "多层扩展大法阵",
            "@Tooltip": "随绘制图案数量逐层展开同心圆环，最大可扩展至 10+ 格半径。",
          },
          elytraFirstPerson: {
            "": "鞘翅第一人称适配",
            "@Tooltip": "鞘翅滑翔时平滑保留第一人称法杖与封装咒术动画，避免穿进镜头。",
          },
          equipFlourish: {
            "": "拔杖与接物挽花",
            "@Tooltip": "切换手持法杖或封装咒术物品时，播放短促利落的转杖或轻抛接物切入动作。",
          },
          orbitalItemMotions: {
            "": "封装物品轨道公转",
            "@Tooltip": "让造物与饰品在胸前走椭圆公转轨道并带释放顶点顿挫，耗尽时抛旋脱手。",
          },
          liveStrokeMirroring: {
            "": "实时落笔笔触跟随",
            "@Tooltip": "在咒术网格按住拖拽连线时，让法杖同步做出压笔前探与抬笔收锋动作。",
          },
          locomotionCasting: {
            "": "身法自适应架势",
            "@Tooltip": "根据潜行、腾空或疾跑状态自动切换低重心压杖、滞空微收腿或侧甩跑投架势。",
          },
          dualWieldSynergy: {
            "": "双持交叉共鸣",
            "@Tooltip": "主副手同时持有施法物品时，副手会在施法时做出镜像护胸或交叉迎合挥动。",
          },
          mindspliceHeadPitch: {
            "": "摄神杖仰头",
            "@Tooltip": "摄神杖收招顶点的额外抬头，单位为弧度。默认 -0.28。",
          },
          quenchedTremor: {
            "": "淬火杖晶颤",
            "@Tooltip": "淬火杖沿杖轴的高频微振，单位为弧度。设为 0 即关闭。",
          },
          quenchedStep: {
            "": "淬火杖阶跃",
            "@Tooltip": "淬火杖瞄准吸附的步进，单位为光标归一化坐标。",
          },
          mindspliceDrift: {
            "": "摄神杖微漂",
            "@Tooltip": "瞄准时摄神杖在掌心中漂动的幅度。",
          },
        },

        server: {
          enabled: {
            "": "启用服务端同步",
            "@Tooltip": "允许 HexAnime 广播施法动画状态。",
          },
          staffAim: {
            "": "法杖瞄准同步",
            "@Tooltip": "绘制咒术图案时，向附近玩家广播法杖指向。",
          },
          packagedHexPulse: {
            "": "封装咒术动画同步",
            "@Tooltip": "广播神符、饰品与造物的使用和耗尽动画。",
          },
          staffPulse: {
            "": "法杖收招同步",
            "@Tooltip": "带施法音效的法术成立时，向周围玩家广播法杖收招。",
          },
          mishapPulse: {
            "": "事故动画同步",
            "@Tooltip": "广播法杖与封装咒术施法事故的全身反应。",
          },
          refreshIntervalTicks: {
            "": "刷新间隔",
            "@Tooltip": "持续施法时重新发送瞄准状态的间隔。",
          },
          maxUpdatesPerSecond: {
            "": "每秒最大更新",
            "@Tooltip": "单个玩家瞄准数据包每秒最多被接受的次数。",
          },
        },
      },
    },
  },
}
