{
  text: {
    "autoconfig.hexanime": {
      title: "HexAnime",

      category: {
        client: "客户端",
        server: "服务端",
      },

      option: {
        client: {
          enabled: {
            "": "启用动画",
            "@Tooltip": "总开关：控制 HexAnime 的手臂与物品动画。",
          },
          damageAnimations: {
            "": "损坏动画",
            "@Tooltip": "媒质或耐久较低时显示颤抖与下垂反馈。",
          },
          cameraShake: {
            "": "视野晃动",
            "@Tooltip": "法杖结术、物品耗尽和施法事故时给镜头一个短促冲击。",
          },
          mishapScreenEffects: {
            "": "事故屏幕特效",
            "@Tooltip": "为媒质、空间和心智事故添加稀有且区分类别的屏幕花纹。",
          },
          firstPersonAnimations: {
            "": "第一人称动画",
            "@Tooltip": "让封装咒术使用原版第一人称模型动画；法杖瞄准仍使用专用手部路径。",
          },
          syncToServer: {
            "": "发送动画状态",
            "@Tooltip": "把你的法杖瞄准状态发送给服务器，供其他玩家看到。",
          },
          receiveRemoteAim: {
            "": "接收法杖瞄准",
            "@Tooltip": "允许服务器向你发送其他玩家的连续法杖瞄准。",
          },
          receiveRemoteEvents: {
            "": "接收施法事件",
            "@Tooltip": "允许接收释放、损坏、耗尽和事故动画事件。",
          },
          staffTipParticles: {
            "": "杖尖微粒",
            "@Tooltip": "透支应变较高时，在杖尖显示少量与颜料同色的微粒。",
          },
          mindspliceHeadPitch: {
            "": "摄神杖仰头",
            "@Tooltip": "摄神杖收招顶点的额外抬头，单位为弧度。默认 -0.28。",
          },
          quenchedTremor: {
            "": "淬火杖晶颤",
            "@Tooltip": "淬火杖沿杖轴的高频微振，单位为弧度。设为 0 即关闭。",
          },
          quenchedStep: {
            "": "淬火杖阶跃",
            "@Tooltip": "淬火杖瞄准吸附的步进，单位为光标归一化坐标。",
          },
          mindspliceDrift: {
            "": "摄神杖微漂",
            "@Tooltip": "瞄准时摄神杖在掌心中漂动的幅度。",
          },
        },

        server: {
          enabled: {
            "": "启用服务端同步",
            "@Tooltip": "允许 HexAnime 广播施法动画状态。",
          },
          staffAim: {
            "": "法杖瞄准同步",
            "@Tooltip": "绘制咒术图案时，向附近玩家广播法杖指向。",
          },
          packagedHexPulse: {
            "": "封装咒术动画同步",
            "@Tooltip": "广播神符、饰品与造物的使用和耗尽动画。",
          },
          staffPulse: {
            "": "法杖收招同步",
            "@Tooltip": "带施法音效的法术成立时，向周围玩家广播法杖收招。",
          },
          mishapPulse: {
            "": "事故动画同步",
            "@Tooltip": "广播法杖与封装咒术施法事故的全身反应。",
          },
          refreshIntervalTicks: {
            "": "刷新间隔",
            "@Tooltip": "持续施法时重新发送瞄准状态的间隔。",
          },
          maxUpdatesPerSecond: {
            "": "每秒最大更新",
            "@Tooltip": "单个玩家瞄准数据包每秒最多被接受的次数。",
          },
        },
      },
    },
  },
}
