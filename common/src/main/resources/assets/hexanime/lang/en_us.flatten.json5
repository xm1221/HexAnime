{
  text: {
    "autoconfig.hexanime": {
      title: "HexAnime",

      category: {
        client: "Client",
        server: "Server",
      },

      option: {
        client: {
          enabled: {
            "": "Enable animations",
            "@Tooltip": "Turns all HexAnime arm and item motion on or off.",
          },
          damageAnimations: {
            "": "Damage animations",
            "@Tooltip": "Shows tremor and droop as media or durability runs low.",
          },
          cameraShake: {
            "": "Camera shake",
            "@Tooltip": "Adds a brief view hit on staff casts, breaks and casting mishaps.",
          },
          firstPersonAnimations: {
            "": "First-person animations",
            "@Tooltip": "Applies the same cast motion to the vanilla first-person hand.",
          },
          syncToServer: {
            "": "Send animation state",
            "@Tooltip": "Sends your spell aim to the server for other players to see.",
          },
          receiveRemoteAim: {
            "": "Receive staff aim",
            "@Tooltip": "Allows the server to send other players' continuous staff aiming.",
          },
          receiveRemoteEvents: {
            "": "Receive cast events",
            "@Tooltip": "Allows release, damage, break and mishap animation events.",
          },
          staffTipParticles: {
            "": "Staff tip particles",
            "@Tooltip": "Shows a few pigment-colored motes at the staff tip while overcast strain is high.",
          },
          mindspliceHeadPitch: {
            "": "Mindsplice nod",
            "@Tooltip": "Extra head pitch, in radians, at the peak of a mindsplice finishing flourish. Default -0.28.",
          },
          quenchedTremor: {
            "": "Quenched shiver",
            "@Tooltip": "Axial micro-vibration of a quenched staff, in radians. Zero turns it off.",
          },
          quenchedStep: {
            "": "Quenched step",
            "@Tooltip": "How coarsely a quenched staff's aim snaps, in cursor units.",
          },
          mindspliceDrift: {
            "": "Mindsplice drift",
            "@Tooltip": "How far a mindsplice staff wanders in the palm while aiming.",
          },
        },

        server: {
          enabled: {
            "": "Enable server sync",
            "@Tooltip": "Allows HexAnime to broadcast cast animation state.",
          },
          staffAim: {
            "": "Staff aim sync",
            "@Tooltip": "Broadcasts cursor-driven staff aiming while the spell grid is open.",
          },
          packagedHexPulse: {
            "": "Packaged Hex pulse sync",
            "@Tooltip": "Broadcasts use and depletion animations for cyphers, trinkets and artifacts.",
          },
          staffPulse: {
            "": "Staff cast pulse sync",
            "@Tooltip": "Broadcasts the staff finishing flourish when a spell with a casting sound resolves.",
          },
          mishapPulse: {
            "": "Mishap animation sync",
            "@Tooltip": "Broadcasts full-body mishap reactions for staff and packaged-Hex casting.",
          },
          refreshIntervalTicks: {
            "": "Refresh interval",
            "@Tooltip": "How often a still-active staff aim is refreshed for newly tracking clients.",
          },
          maxUpdatesPerSecond: {
            "": "Maximum updates per second",
            "@Tooltip": "Upper bound for accepted staff aim packets from one player.",
          },
        },
      },
    },
  },
}
