{
  "schemaVersion": 1,
  "id": "hexanime",
  "version": "${version}",
  "name": "HexAnime",
  "description": "Player animation mod for Hex Casting staff casting",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/HexAnime",
    "sources": "https://github.com/xm1221/HexAnime"
  },
  "license": "MIT",
  "icon": "assets/hexanime/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.hexanime.fabric.FabricHexAnime"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.hexanime.fabric.FabricHexAnimeClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.hexanime.fabric.FabricHexAnimeServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.hexanime.fabric.datagen.FabricHexAnimeDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.hexanime.fabric.FabricHexAnimeModMenu"
    }]
  },
  "mixins": [
    "hexanime-common.mixins.json",
    "hexanime-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "cloth-config": ">=${versions.clothConfig}",
    "playeranimator": "*"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}",
    "hexcasting": ">=${versions.hexcasting}"
  }
}
